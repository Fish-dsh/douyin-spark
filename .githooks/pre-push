#!/usr/bin/env bash
# pre-push 钩子: 推送前跑一遍快速自检 (语法 + JS 语法 + lint)，不跑单测以免拖慢推送。
#
# 这个仓库没有远端 CI (推送令牌没有 workflow 权限)，所以本地是唯一闸门。
#
# 注意: 钩子**不会**随 clone 自动生效，每个 clone 要手动开一次:
#   git config core.hooksPath .githooks
# 也可以绕过 (git push --no-verify)，所以它只是提醒，不是保证。
#
# 退出码怎么读:
#   0 全部跑过        -> 放行
#   1 有检查真的失败  -> 拦下(拦截是这里唯一该做的事)
#   2 没失败但漏检了  -> 放行 + 警告
# 2 必须放行: 干净 clone 没装 ruff/node 时 SKIPPED 必然非 0, 把它当失败
# 等于「没装开发依赖的人永远推不了代码」, 那不是闸门是路障。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 0

if [ ! -x tools/verify.sh ]; then
  echo 'pre-push: 找不到 tools/verify.sh，跳过自检' >&2
  exit 0
fi

./tools/verify.sh --fast
rc=$?
case "$rc" in
  0) exit 0 ;;
  2)
    echo >&2
    echo 'pre-push: 自检没有失败，但有几项因为缺工具没跑到(见上面的 SKIPPED)。' >&2
    echo 'pre-push: 这次照常放行；想真正验证到就装齐开发依赖再跑 tools/verify.sh。' >&2
    exit 0
    ;;
  *)
    echo >&2
    echo 'pre-push 自检未通过, 已拦下这次推送。' >&2
    echo '确认要硬推: git push --no-verify' >&2
    exit 1
    ;;
esac
